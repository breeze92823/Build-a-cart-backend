# Copy to .env (gitignored) for local development. None of these are
# required to run `npm start` -- every one degrades gracefully when unset.

# MongoDB connection string for player-progress persistence. Bloxity Legion
# hosting injects this per game+channel in deployed environments; leave unset
# locally to run with persistence disabled (progress lasts the connection only).
MONGODB_URI=

# CORS allow-origin for deployed environments. Falls back to "*" when unset.
CLIENT_ORIGIN=

# HTTP port. Falls back to 2567 when unset.
PORT=2567

# --- Bloxity hosting (all injected by Legion in deployed environments) -------------
# Leave unset locally: the server then trusts the client's dev- id (non-production only),
# reports no leaderboard scores and pushes no room directory.

# Bloxity API origin for token verification (/v1/auth/game-token/verify), rewarded-ad
# verification (/v1/ads/reward/verify) and leaderboard reports. Defaults to https://api.bloxity.io.
BLOXITY_API_URL=

# The game id / slug on bloxity.io. Defaults to "build-a-cart".
BLOXITY_GAME_ID=

# Bearer token for the server-side leaderboard report and the room directory push.
# Unset = both are no-ops.
BLOXITY_REPORT_TOKEN=

# Matchmaker base URL the room directory snapshot is POSTed to every ~2 s
# ({MATCHMAKER_REPORT_URL}/{gameId}/rooms). Unset = no directory push.
MATCHMAKER_REPORT_URL=

# This pod's name, reported with the room snapshot (falls back to HOSTNAME).
POD_NAME=

# Per-game secret, stable across deploys (not used by this server yet).
JWT_SECRET=

# "production" in deployed environments: only a Bloxity-verified token identifies a player
# (a client-sent id is ignored), and the /monitor and playground dev tools are off.
NODE_ENV=
